DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin the OAuth callbacks redirect back to after login
FRONTEND_URL=http://localhost:5173

# Google SSO (OAuth2/OIDC) - create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:8000/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho SSO (OAuth2) - create a Server-based Application client at
# https://api-console.zoho.com/ with redirect URI
# http://localhost:8000/api/auth/zoho/callback/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Logging: "stdout" (default, plain console logs for dev) or "otel" (export via
# OpenTelemetry OTLP). When set to "otel", the standard OTEL_EXPORTER_OTLP_ENDPOINT
# and OTEL_SERVICE_NAME env vars control where logs go / how the service is labeled.
LOG_BACKEND=stdout
OTEL_SERVICE_NAME=demo-app-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318